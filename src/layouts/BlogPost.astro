---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_TITLE, SITE_URL, CATEGORIES, ADSENSE_SLOTS, AUTHOR_PROFILE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	keywords,
	author,
	sources,
	faq,
} = Astro.props;

const cat = CATEGORIES[category];
const catColor = `var(--cat-${category})`;
const bannerBg = `radial-gradient(circle at 30% 20%, rgba(255,255,255,0.28), transparent 55%), ${catColor}`;
const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = heroImage
	? new URL(heroImage.src, Astro.site).href
	: new URL('/og.jpg', Astro.site).href;
const isHealth = category === 'health';

// ── JSON-LD 구조화 데이터 ──────────────────────────────────
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': isHealth ? 'MedicalWebPage' : 'Article',
	headline: title,
	description,
	image: ogImageUrl,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: author,
		description: AUTHOR_PROFILE.bio,
		jobTitle: AUTHOR_PROFILE.role,
		url: `${SITE_URL}/about/`,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: SITE_URL,
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
	keywords: (keywords.length ? keywords : tags).join(', '),
	inLanguage: 'ko',
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '홈', item: SITE_URL },
		{
			'@type': 'ListItem',
			position: 2,
			name: cat.name,
			item: `${SITE_URL}/category/${cat.slug}/`,
		},
		{ '@type': 'ListItem', position: 3, name: title, item: pageURL },
	],
};

const faqSchema =
	faq.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faq.map((f) => ({
					'@type': 'Question',
					name: f.q,
					acceptedAnswer: { '@type': 'Answer', text: f.a },
				})),
			}
		: null;

const schema = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<html lang="ko">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			type="article"
			keywords={keywords.length ? keywords : tags}
			publishedTime={pubDate.toISOString()}
			modifiedTime={(updatedDate ?? pubDate).toISOString()}
			schema={schema}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.breadcrumb {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1em auto 0;
				padding: 0 1em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				text-decoration: underline;
			}
			.title {
				margin-bottom: 1em;
				padding: 0.5em 0;
				text-align: center;
			}
			.title h1 {
				margin: 0.2em 0 0.4em 0;
				line-height: 1.3;
			}
			.cat-badge {
				display: inline-block;
				padding: 0.25em 0.8em;
				border-radius: 999px;
				background: var(--accent);
				color: white;
				font-size: 0.8em;
				text-decoration: none;
			}
			.date {
				margin-top: 0.6em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.disclaimer-box {
				margin: 1.5em 0;
				padding: 1em 1.2em;
				border-left: 4px solid #d9822b;
				background: #fff6ea;
				border-radius: 6px;
				font-size: 0.9em;
				line-height: 1.6;
			}
			.faq-section {
				margin: 2.5em 0 1em;
			}
			.faq-section h2 {
				border-bottom: 2px solid var(--accent);
				padding-bottom: 0.3em;
			}
			.faq-item {
				margin: 1em 0;
				padding: 1em 1.2em;
				background: rgba(var(--gray-light), 0.5);
				border-radius: 8px;
			}
			.faq-item .q {
				font-weight: 700;
				margin: 0 0 0.4em;
			}
			.faq-item .a {
				margin: 0;
				line-height: 1.7;
			}
			.sources {
				margin: 2em 0 1em;
				padding: 1em 1.2em;
				border: 1px solid rgba(var(--gray), 0.25);
				border-radius: 8px;
				font-size: 0.9em;
			}
			.sources h3 {
				margin: 0 0 0.5em;
				font-size: 1em;
			}
			.sources ul {
				margin: 0;
				padding-left: 1.2em;
			}
			.author-box {
				margin: 2.5em 0 1em;
				padding: 1.2em 1.4em;
				border: 1px solid rgb(var(--border));
				border-radius: 8px;
				background: var(--surface);
				font-size: 0.92em;
				line-height: 1.7;
			}
			.author-box .ab-name {
				margin: 0 0 0.15em;
				font-weight: 700;
				font-size: 1.05em;
			}
			.author-box .ab-role {
				margin: 0 0 0.6em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.author-box p {
				margin: 0 0 0.6em;
			}
			.author-box .ab-policy {
				margin: 0;
				padding-top: 0.7em;
				border-top: 1px dashed rgb(var(--border));
				color: rgb(var(--gray));
				font-size: 0.88em;
			}
			.tags {
				margin: 1.5em 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.tag {
				font-size: 0.82em;
				padding: 0.2em 0.7em;
				background: rgba(var(--gray-light), 0.8);
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="breadcrumb">
				<a href="/">홈</a> ›
				<a href={`/category/${cat.slug}/`}>{cat.name}</a> ›
				<span>{title}</span>
			</nav>
			<article>
				<div class="prose">
					<div class="title">
						<a class="cat-badge" href={`/category/${cat.slug}/`}>{cat.emoji} {cat.name}</a>
						<h1>{title}</h1>
						<div class="date">
							<FormattedDate date={pubDate} /> 작성
							{updatedDate && (
								<span class="last-updated-on">
									· <FormattedDate date={updatedDate} /> 업데이트
								</span>
							)}
						</div>
					</div>

					<div class="hero-banner" style={`background:${bannerBg}`}>
						<span class="hb-emoji">{cat.emoji}</span>
						<span class="hb-label">{cat.name}</span>
					</div>

					<AdSlot slot={ADSENSE_SLOTS.belowTitle} label="상단 광고" />

					{isHealth && (
						<div class="disclaimer-box">
							⚕️ <strong>건강정보 안내</strong> — 이 글은 일반적인 건강 정보 제공을 목적으로 하며,
							의학적 진단이나 처방을 대체하지 않습니다. 증상이 지속되거나 심할 경우 반드시 의료
							전문가와 상담하세요.
						</div>
					)}

					<slot />

					<aside class="author-box">
						<p class="ab-name">✍️ {author}</p>
						<p class="ab-role">{AUTHOR_PROFILE.role}</p>
						<p>{AUTHOR_PROFILE.bio}</p>
						<p class="ab-policy">{AUTHOR_PROFILE.policy}</p>
					</aside>

					{sources.length > 0 && (
						<div class="sources">
							<h3>📚 참고 자료</h3>
							<ul>
								{sources.map((s) => (
									<li>
										<a href={s.url} target="_blank" rel="noopener noreferrer nofollow">
											{s.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					{faq.length > 0 && (
						<section class="faq-section">
							<h2>자주 묻는 질문 (FAQ)</h2>
							{faq.map((f) => (
								<div class="faq-item">
									<p class="q">Q. {f.q}</p>
									<p class="a">A. {f.a}</p>
								</div>
							))}
						</section>
					)}

					{tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => (
								<span class="tag">#{t}</span>
							))}
						</div>
					)}

					<AdSlot slot={ADSENSE_SLOTS.footer} label="하단 광고" />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
