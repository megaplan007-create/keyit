---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE_TITLE, CATEGORIES, CATEGORY_ORDER } from '../consts';

// 방문자를 사이트 밖으로 내보내지 않도록, 최근 글을 함께 안내합니다.
const latest = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<Page
	title="페이지를 찾을 수 없습니다"
	description={`요청하신 페이지가 없습니다. ${SITE_TITLE}의 다른 글을 찾아보세요.`}
>
	<h1>페이지를 찾을 수 없습니다</h1>
	<p>
		요청하신 주소의 페이지가 없습니다. 주소가 잘못 입력되었거나, 글이 이동 또는 삭제되었을 수
		있습니다.
	</p>

	<h2>카테고리에서 찾기</h2>
	<ul>
		{
			CATEGORY_ORDER.map((key) => (
				<li>
					<a href={`/category/${CATEGORIES[key].slug}/`}>
						{CATEGORIES[key].emoji} {CATEGORIES[key].name}
					</a>{' '}
					— {CATEGORIES[key].description}
				</li>
			))
		}
	</ul>

	<h2>최근에 올라온 글</h2>
	<ul>
		{
			latest.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
				</li>
			))
		}
	</ul>

	<h2>그 밖에</h2>
	<ul>
		<li><a href="/">홈으로 돌아가기</a></li>
		<li><a href="/blog/">전체 글 목록</a></li>
		<li><a href="/contact/">찾으시는 내용을 문의하기</a></li>
	</ul>
</Page>
