---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_URL,
	CATEGORIES,
	CATEGORY_ORDER,
	ADSENSE_SLOTS,
} from '../consts';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = allPosts.slice(0, 6);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: SITE_URL,
	description: SITE_DESCRIPTION,
	inLanguage: 'ko',
};

const values = [
	{ icon: '📑', title: '공식 자료 기반', desc: '정부·공공기관 등 공신력 있는 자료를 근거로 작성하고 출처를 명시합니다.' },
	{ icon: '🔄', title: '최신 정보 유지', desc: '정책과 정보가 바뀌면 글을 업데이트해 항상 정확한 내용을 전합니다.' },
	{ icon: '💬', title: '누구나 쉽게', desc: '어려운 용어를 풀어 누구나 이해할 수 있는 언어로 정리합니다.' },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} — 믿을 수 있는 생활·건강 정보`} description={SITE_DESCRIPTION} schema={websiteSchema} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			/* ── Hero ───────────────────────────── */
			.hero {
				position: relative;
				text-align: center;
				padding: 6em 1.2em 5.5em;
				min-height: 60vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				color: #fff;
				/* 영상이 없을 때 보이는 폴백 배경 */
				background: linear-gradient(135deg, #00806a 0%, #00a885 55%, #2bc9a6 100%);
			}
			.hero-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				z-index: 0;
			}
			.hero-overlay {
				position: absolute;
				inset: 0;
				z-index: 1;
				background: linear-gradient(90deg, rgba(5, 37, 35, 0.92) 0%, rgba(7, 67, 59, 0.76) 45%, rgba(4, 44, 38, 0.18) 100%);
			}
			.hero-content {
				position: relative;
				z-index: 2;
				width: 100%;
				max-width: var(--maxw);
				text-align: left;
			}
			.hero-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.4em 1em;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.15);
				border: 1px solid rgba(255, 255, 255, 0.35);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				color: #fff;
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 1.4em;
			}
			.hero h1 {
				font-size: 3rem;
				margin: 0 0 0.5em;
				line-height: 1.25;
				letter-spacing: -0.03em;
				color: #fff;
				text-shadow: 0 2px 24px rgba(0, 0, 0, 0.28);
			}
			.hero h1 .accent {
				color: #a7ffe6;
			}
			.hero p {
				color: rgba(255, 255, 255, 0.94);
				max-width: 610px;
				margin: 0;
				font-size: 1.12rem;
				line-height: 1.75;
				text-shadow: 0 1px 12px rgba(0, 0, 0, 0.25);
			}
			.hero-cta {
				display: flex;
				justify-content: flex-start;
				gap: 0.8em;
				margin-top: 2em;
				flex-wrap: wrap;
			}
			.hero-note {
				display: flex;
				gap: 1em;
				flex-wrap: wrap;
				margin-top: 2.2em;
				font-size: 0.82rem;
				color: rgba(255, 255, 255, 0.86);
			}
			.hero-note span { display: inline-flex; align-items: center; gap: 0.35em; }
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.85em 1.7em;
				border-radius: 999px;
				font-weight: 700;
				font-size: 1rem;
				transition: all 0.15s ease;
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
				box-shadow: 0 6px 18px rgba(0, 168, 133, 0.35);
			}
			.btn-primary:hover {
				background: var(--accent-dark);
				color: #fff;
				transform: translateY(-2px);
			}
			.btn-ghost {
				background: rgba(255, 255, 255, 0.14);
				color: #fff;
				border: 1px solid rgba(255, 255, 255, 0.5);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
			}
			.btn-ghost:hover {
				background: rgba(255, 255, 255, 0.25);
				color: #fff;
			}

			/* ── 공통 섹션 ───────────────────────── */
			.section {
				max-width: var(--maxw);
				margin: 4.5em auto;
				padding: 0 1.2em;
			}
			.section-title {
				text-align: center;
				margin-bottom: 0.5em;
			}
			.section-title h2 {
				font-size: 1.8rem;
				margin: 0 0 0.3em;
			}
			.section-title p {
				color: rgb(var(--gray));
				margin: 0;
			}

			/* ── 소개 + 가치 블록 ────────────────── */
			.intro {
				background: var(--surface);
				border-top: 1px solid rgb(var(--border));
				border-bottom: 1px solid rgb(var(--border));
				padding: 4em 1.2em;
			}
			.intro-inner {
				max-width: var(--maxw);
				margin: 0 auto;
			}
			.values {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
				margin-top: 2.5em;
			}
			.editorial-strip {
				max-width: var(--maxw);
				margin: -2.2em auto 0;
				padding: 0 1.2em;
				position: relative;
				z-index: 3;
			}
			.editorial-panel {
				display: grid;
				grid-template-columns: 1.1fr 2fr;
				gap: 2em;
				align-items: center;
				background: #fff;
				padding: 1.2em 1.6em;
				border-radius: var(--radius);
				box-shadow: 0 12px 32px rgba(15, 23, 42, 0.15);
				border: 1px solid rgb(var(--border));
			}
			.editorial-panel strong { color: var(--accent-dark); }
			.editorial-panel p { margin: 0; font-size: 0.9rem; color: rgb(var(--gray)); line-height: 1.65; }
			.editorial-points { display: flex; gap: 1em; flex-wrap: wrap; }
			.editorial-points span { font-size: 0.82rem; font-weight: 700; color: rgb(var(--gray-dark)); }
			.value-card {
				background: var(--accent-soft);
				border: 1px solid var(--accent-light);
				border-radius: var(--radius);
				padding: 1.8em 1.5em;
				text-align: center;
			}
			.value-card .v-icon {
				font-size: 2.2rem;
			}
			.value-card h3 {
				margin: 0.5em 0 0.3em;
				font-size: 1.15rem;
			}
			.value-card p {
				margin: 0;
				font-size: 0.92rem;
				color: rgb(var(--gray));
				line-height: 1.65;
			}

			/* ── 카테고리 쇼케이스 ───────────────── */
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
				margin-top: 2em;
			}
			.cat-card {
				display: block;
				border-radius: var(--radius);
				padding: 2em 1.6em;
				color: #fff;
				text-decoration: none;
				position: relative;
				overflow: hidden;
				transition: transform 0.18s ease, box-shadow 0.18s ease;
				box-shadow: var(--box-shadow);
			}
			.cat-card:hover {
				transform: translateY(-5px);
				box-shadow: var(--box-shadow-lg);
				color: #fff;
			}
			.cat-card .c-emoji {
				font-size: 2rem;
			}
			.cat-card h3 {
				margin: 0.4em 0 0.3em;
				color: #fff;
				font-size: 1.3rem;
			}
			.cat-card p {
				margin: 0 0 0.8em;
				font-size: 0.9rem;
				opacity: 0.92;
				line-height: 1.6;
			}
			.cat-card .go {
				font-weight: 700;
				font-size: 0.9rem;
			}

			/* ── 블로그 섹션 (애드센스·콘텐츠 중심) ── */
			.blog-zone {
				background: var(--surface);
				border-top: 1px solid rgb(var(--border));
				padding: 3.5em 0 1em;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.3em;
			}
			.section-head h2 {
				font-size: 1.5rem;
				margin: 0;
			}
			.section-head a {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--accent-dark);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.6em;
			}
			.empty {
				color: rgb(var(--gray));
				padding: 3em 0;
				text-align: center;
			}

			@media (max-width: 860px) {
				.values,
				.cat-grid,
				.grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.hero h1 {
					font-size: 2.1rem;
				}
				.editorial-panel { grid-template-columns: 1fr; gap: 0.6em; }
			}
			@media (max-width: 560px) {
				.values,
				.cat-grid,
				.grid {
					grid-template-columns: 1fr;
				}
				.hero {
					padding: 3.5em 1.2em 3em;
				}
				.hero-content, .hero { text-align: center; }
				.hero p { margin-left: auto; margin-right: auto; }
				.hero-cta, .hero-note { justify-content: center; }
				.editorial-strip { margin-top: -1.5em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 첫인상: 운영 원칙이 보이는 정보매체형 헤더 -->
			<section class="hero">
				<img class="hero-img" src="/hero-editorial-v2.webp" alt="" loading="eager" fetchpriority="high" />
				<div class="hero-overlay"></div>
				<div class="hero-content">
					<span class="hero-badge">공식 자료를 읽고, 생활에 맞게 정리합니다</span>
					<h1>알아야 할 기준을<br /><span class="accent">쉽고 정확하게</span></h1>
					<p>{SITE_DESCRIPTION}</p>
					<div class="hero-cta">
						<a class="btn btn-primary" href="#latest">최근 발행 글 보기 →</a>
						<a class="btn btn-ghost" href="/about/">운영 원칙 보기</a>
					</div>
					<div class="hero-note">
						<span>✓ 출처를 남깁니다</span><span>✓ 기준 변경 시 갱신합니다</span><span>✓ 광고보다 정보가 먼저입니다</span>
					</div>
				</div>
			</section>

			<div class="editorial-strip">
				<div class="editorial-panel">
					<div><strong>생활건강 노트의 편집 기준</strong><p>읽고 끝나는 요약이 아니라, 신청·판단·확인에 필요한 기준을 한 페이지에 담습니다.</p></div>
					<div class="editorial-points"><span>01 공식 기관 원문 확인</span><span>02 놓치기 쉬운 예외 정리</span><span>03 갱신일·출처 공개</span></div>
				</div>
			</div>

			<!-- 소개 + 가치 -->
			<section class="intro">
				<div class="intro-inner">
					<div class="section-title">
						<h2>{SITE_TITLE}는 이런 곳이에요</h2>
						<p>흩어진 생활·건강·정책 정보를 한곳에 모아, 믿을 수 있게 정리합니다.</p>
					</div>
					<div class="values">
						{values.map((v) => (
							<div class="value-card">
								<div class="v-icon">{v.icon}</div>
								<h3>{v.title}</h3>
								<p>{v.desc}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- 카테고리 쇼케이스 -->
			<section class="section">
				<div class="section-title">
					<h2>무엇을 다루나요?</h2>
					<p>관심 있는 주제를 골라 바로 살펴보세요.</p>
				</div>
				<div class="cat-grid">
					{CATEGORY_ORDER.map((key) => {
						const c = CATEGORIES[key];
						return (
							<a class="cat-card" href={`/category/${c.slug}/`} style={`background:var(--cat-${key})`}>
								<div class="c-emoji">{c.emoji}</div>
								<h3>{c.name}</h3>
								<p>{c.description}</p>
								<span class="go">바로가기 →</span>
							</a>
						);
					})}
				</div>
			</section>

			<!-- 블로그 존 (애드센스·콘텐츠 중심) -->
			<section class="blog-zone" id="latest">
				<div class="section" style="margin:0 auto 2em">
					<AdSlot slot={ADSENSE_SLOTS.belowTitle} label="광고" />
					<div class="section-head">
						<h2>📰 최신 글</h2>
						<a href="/blog/">전체보기 →</a>
					</div>
					{latest.length > 0 ? (
						<div class="grid">
							{latest.map((post) => <PostCard post={post} />)}
						</div>
					) : (
						<p class="empty">아직 발행된 글이 없습니다. 곧 유용한 정보로 채워집니다!</p>
					)}
				</div>

				{CATEGORY_ORDER.map((key) => {
					const posts = allPosts.filter((p) => p.data.category === key).slice(0, 3);
					if (posts.length === 0) return null;
					return (
						<div class="section" style="margin:0 auto 2.5em">
							<div class="section-head">
								<h2>{CATEGORIES[key].emoji} {CATEGORIES[key].name}</h2>
								<a href={`/category/${CATEGORIES[key].slug}/`}>더보기 →</a>
							</div>
							<div class="grid">
								{posts.map((post) => <PostCard post={post} />)}
							</div>
						</div>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>
